# 复制为 .env 后填入真实值；.env 不会被提交。
# .env.example 本身可以提交，其中的值必须全部是占位符。
# 规则：键名保持完整（方便他人照抄），值一律使用占位符。

# --- 应用 ---
APP_ENV=development
APP_PORT=8000
DEBUG=true

# --- 数据库 ---
DATABASE_URL=your_db_scheme://your_user:your_password@localhost:5432/your_db
REDIS_URL=redis://localhost:6379/0

# --- 第三方服务（占位符，勿填真实密钥）---
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
THIRD_PARTY_TOKEN=YOUR_TOKEN_HERE

# --- 本地路径（勿写真实绝对路径，建议用相对路径）---
# LOCAL_DATA_DIR=/path/to/your/data

# --- 身份相关（勿写真实用户名/邮箱）---
# OPERATOR=your_username
# CONTACT_EMAIL=you@example.com
